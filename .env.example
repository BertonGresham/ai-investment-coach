# AI service reads ai-service/.env; see ai-service/.env.example.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
USE_MOCK_LLM=true
# Optional OpenAI provider / Chroma embeddings.
OPENAI_API_KEY=

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ai_investment_coach
MYSQL_USER=coach
MYSQL_PASSWORD=coach_password

REDIS_HOST=localhost
REDIS_PORT=6379

AI_SERVICE_URL=http://localhost:8001
DATA_SERVICE_URL=http://localhost:8002
BACKEND_SERVER_URL=http://localhost:8080
