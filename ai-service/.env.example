USE_MOCK_LLM=true
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional: use a different Claude model for screenshot recognition.
ANTHROPIC_VISION_MODEL=
# Only used with LLM_PROVIDER=openai or optional Chroma embeddings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PERSIST_DIRECTORY=./.chroma
CHROMA_COLLECTION=investment_behavior
AI_SERVICE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
